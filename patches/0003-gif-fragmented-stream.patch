+        const size_t loops=tag&0x7fffu;
+        const unsigned format=static_cast<unsigned>((tag>>58)&3u);
+        size_t registers=(tag>>60)&15u;
+        if (!registers) registers=16;
+        const size_t payload=format==0 ? loops*registers*16u :
+            format==1 ? ((loops*registers+1u)/2u)*16u : loops*16u;
+        const size_t bytes=16u+payload;
+        if (m_gifStreamPending.size()-complete<bytes) break;
+        complete+=bytes;
+    }
+    if (complete)
+    {
+        processCompleteGIFPacket(m_gifStreamPending.data(),static_cast<uint32_t>(complete));
+        m_gifStreamPending.erase(m_gifStreamPending.begin(),m_gifStreamPending.begin()+complete);
+    }
