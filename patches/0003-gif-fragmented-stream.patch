 void GS::processGIFPacket(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (!data || !sizeBytes || !m_backend) return;
+    m_gifStreamPending.insert(m_gifStreamPending.end(),data,data+sizeBytes);
+    size_t complete=0;
