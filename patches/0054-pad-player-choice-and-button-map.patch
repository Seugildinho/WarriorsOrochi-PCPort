+    // A escolha de controle de UM jogador, lida de OROCHI_PAD_PLAYER1/2.
+    struct OrochiPlayerControllerChoice
+    {
+        enum class Kind
+        {
+            Automatic,      // "auto": o proximo controle livre
+            NoController,   // "none": este jogador nao usa controle
+            SpecificDevice, // "<indice>:<nome>": um controle especifico
+        } kind = Kind::Automatic;
+        int indexWhenChosen = -1; // posicao do controle quando foi escolhido no Setup
+        std::string deviceName;   // nome do controle (GetGamepadName), ex.: "Xbox Controller"
+    };
+
+    // Le uma variavel OROCHI_PAD_PLAYERn. Valor ausente ou invalido = automatico.
+    // Exemplos: "none" -> NoController; "0:Wireless Controller" -> SpecificDevice
+    // com indice 0 e nome "Wireless Controller".
+    OrochiPlayerControllerChoice readPlayerControllerChoiceFromEnvironment(const char *variableName)
+    {
+        OrochiPlayerControllerChoice choice;
+        const char *text = std::getenv(variableName);
+        if (!text || !*text || std::strcmp(text, "auto") == 0)
+            return choice;
+        if (std::strcmp(text, "none") == 0)
+        {
+            choice.kind = OrochiPlayerControllerChoice::Kind::NoController;
+            return choice;
+        }
+        const char *colon = std::strchr(text, ':');
+        if (!colon || colon == text)
+            return choice; // formato desconhecido: fica automatico
+        choice.kind = OrochiPlayerControllerChoice::Kind::SpecificDevice;
+        choice.indexWhenChosen = std::atoi(text);
+        choice.deviceName = colon + 1;
+        return choice;
+    }
+
+    // Le OROCHI_PAD_BUTTONS_PLAYERn. Qualquer erro (numero faltando, valor
+    // fora de 0..17) devolve o mapeamento padrao inteiro, para nunca deixar o
+    // jogador com botoes quebrados.
+    std::array<int, 16> readButtonMapFromEnvironment(const char *variableName)
+    {
+        const char *text = std::getenv(variableName);
+        if (!text || !*text)
+            return kOrochiDefaultPhysicalButtonForEachPs2Button;
+        std::array<int, 16> map{};
+        const char *at = text;
+        for (size_t index = 0; index < map.size(); ++index)
+        {
+            char *end = nullptr;
+            const long value = std::strtol(at, &end, 10);
+            if (end == at || value < GAMEPAD_BUTTON_UNKNOWN || value > GAMEPAD_BUTTON_RIGHT_THUMB)
+                return kOrochiDefaultPhysicalButtonForEachPs2Button;
+            map[index] = static_cast<int>(value);
+            at = (*end == ',') ? end + 1 : end;
+        }
+        return map;
+    }
+
+    // Tudo que vem das variaveis, lido UMA vez (as variaveis nao mudam
+    // durante o jogo). Indice 0 = jogador 1 (porta 0), 1 = jogador 2 (porta 1).
+    struct OrochiControllerSettingsFromEnvironment
+    {
+        std::array<OrochiPlayerControllerChoice, 2> controllerChoiceForPlayerPort;
+        std::array<std::array<int, 16>, 2> buttonMapForPlayerPort;
+        int keyboardPlayerPort = 0; // 0 = jogador 1, 1 = jogador 2, -1 = teclado desligado
+    };
+
+    const OrochiControllerSettingsFromEnvironment &controllerSettingsFromEnvironment()
+    {
+        static const OrochiControllerSettingsFromEnvironment settings = [] {
+            OrochiControllerSettingsFromEnvironment loaded;
+            loaded.controllerChoiceForPlayerPort[0] = readPlayerControllerChoiceFromEnvironment("OROCHI_PAD_PLAYER1");
+            loaded.controllerChoiceForPlayerPort[1] = readPlayerControllerChoiceFromEnvironment("OROCHI_PAD_PLAYER2");
+            loaded.buttonMapForPlayerPort[0] = readButtonMapFromEnvironment("OROCHI_PAD_BUTTONS_PLAYER1");
+            loaded.buttonMapForPlayerPort[1] = readButtonMapFromEnvironment("OROCHI_PAD_BUTTONS_PLAYER2");
+            if (const char *keyboard = std::getenv("OROCHI_KEYBOARD_PLAYER"))
+                loaded.keyboardPlayerPort = std::strcmp(keyboard, "2") == 0 ? 1 : std::strcmp(keyboard, "0") == 0 ? -1 : 0;
+            return loaded;
+        }();
+        return settings;
+    }
+
+    // Procura, entre os controles conectados, o que foi escolhido no Setup.
+    // Ordem de preferencia:
+    //   1. o controle na mesma posicao E com o mesmo nome;
+    //   2. o primeiro controle com o mesmo nome (a ordem mudou ao reconectar);
+    // Retorna -1 se nenhum controle com esse nome estiver conectado.
+    // Ex.: escolhido "1:Xbox Controller", conectados [0:"DualSense", 1:"Xbox
+    // Controller"] -> 1. Se so houver [0:"Xbox Controller"] -> 0.
+    int findConnectedGamepadMatchingChoice(const OrochiPlayerControllerChoice &choice)
+    {
+        if (choice.indexWhenChosen >= 0 && choice.indexWhenChosen < kMaxGamepads &&
+            IsGamepadAvailable(choice.indexWhenChosen) &&
+            choice.deviceName == GetGamepadName(choice.indexWhenChosen))
+            return choice.indexWhenChosen;
+        for (int index = 0; index < kMaxGamepads; ++index)
+            if (IsGamepadAvailable(index) && choice.deviceName == GetGamepadName(index))
+                return index;
+        return -1;
+    }
+
+    // Qual controle (indice do raylib, 0..3) joga na porta "port" do PS2.
+    // -1 = nenhum. Substitui gamepadForPort (que continua abaixo, sem uso,
+    // so como referencia). Regras:
+    //   - Janela do jogo fora de foco: nenhum (igual ao patch 0050).
+    //   - Portas 2 e 3 (multitap): comportamento antigo, gamepadForPort.
+    //   - Jogador com "none": nenhum.
+    //   - Jogador com controle especifico conectado: esse controle.
+    //   - Automatico (ou especifico desconectado): o proximo controle que nao
+    //     foi escolhido especificamente por ninguem, na ordem dos jogadores.
+    // Ex.: P1 automatico, P2 = "Xbox Controller", conectados [0:"Xbox
+    // Controller", 1:"DualSense"] -> P2 joga com 0 e P1 com 1 (o livre).
+    int gamepadIndexForPlayerPort(int port)
+    {
+        if (port < 0)
+            return -1;
+        if (port >= 2)
+            return gamepadForPort(port);
+        if (!IsWindowFocused())
+            return -1;
+        const auto &settings = controllerSettingsFromEnvironment();
+        using Kind = OrochiPlayerControllerChoice::Kind;
+        // Resolve os dois jogadores: indice do controle especifico ou -1.
+        std::array<int, 2> specificIndex{-1, -1};
+        std::array<bool, 2> usesAutomatic{false, false};
+        for (int player = 0; player < 2; ++player)
+        {
+            const auto &choice = settings.controllerChoiceForPlayerPort[player];
+            if (choice.kind == Kind::NoController)
+                continue;
+            if (choice.kind == Kind::SpecificDevice)
+                specificIndex[player] = findConnectedGamepadMatchingChoice(choice);
+            usesAutomatic[player] = specificIndex[player] < 0;
+        }
+        if (settings.controllerChoiceForPlayerPort[port].kind == Kind::NoController)
+            return -1;
+        if (specificIndex[port] >= 0)
+            return specificIndex[port];
+        // Automatico: quantos jogadores automaticos vem antes deste?
+        const int automaticRank = (port == 1 && usesAutomatic[0]) ? 1 : 0;
+        int freeSeen = 0;
+        for (int index = 0; index < kMaxGamepads; ++index)
+        {
+            if (!IsGamepadAvailable(index) || index == specificIndex[0] || index == specificIndex[1])
+                continue;
+            if (freeSeen == automaticRank)
+                return index;
+            ++freeSeen;
+        }
+        return -1;
+    }
+
+    // Botao fisico apertado? Igual a IsGamepadButtonDown, mas L2/R2 tambem
+    // contam pelo eixo do gatilho (em controles XInput os gatilhos sao eixos
+    // de -1 a 1 e nem todo mapeamento os repete como botao). Assim um botao
+    // do PS2 mapeado para um gatilho funciona em qualquer controle.
+    bool isPhysicalGamepadButtonDown(int gamepad, int physicalButton)
+    {
+        if (physicalButton <= GAMEPAD_BUTTON_UNKNOWN)
+            return false; // 0 = "nenhum botao" no mapeamento
+        if (IsGamepadButtonDown(gamepad, physicalButton))
+            return true;
+        if (physicalButton == GAMEPAD_BUTTON_LEFT_TRIGGER_2)
+            return GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_LEFT_TRIGGER) > kTriggerThreshold;
+        if (physicalButton == GAMEPAD_BUTTON_RIGHT_TRIGGER_2)
+            return GetGamepadAxisMovement(gamepad, GAMEPAD_AXIS_RIGHT_TRIGGER) > kTriggerThreshold;
+        return false;
+    }
+
+    // Escreve no log (data\port.log) sempre que o controle de um jogador muda,
+    // para identificar qual controle ficou com quem. Ex.:
+    //   [Orochi:pad] jogador 1: controle 0 (Xbox Controller)
+    //   [Orochi:pad] jogador 2: sem controle
+    // Fora de foco a janela devolve -1; isso nao e registrado para nao
+    // encher o log cada vez que o usuario troca de janela.
+    void logPlayerControllerWhenItChanges(int port, int gamepad)
+    {
+        static std::array<int, 2> lastLoggedGamepad{-2, -2};
+        if (port < 0 || port >= 2 || !IsWindowFocused() || lastLoggedGamepad[port] == gamepad)
+            return;
+        lastLoggedGamepad[port] = gamepad;
+        if (gamepad >= 0)
+            std::cout << "[Orochi:pad] jogador " << (port + 1) << ": controle " << gamepad << " ("
+                      << GetGamepadName(gamepad) << ")" << std::endl;
+        else
+            std::cout << "[Orochi:pad] jogador " << (port + 1) << ": sem controle" << std::endl;
+    }
 }
 
