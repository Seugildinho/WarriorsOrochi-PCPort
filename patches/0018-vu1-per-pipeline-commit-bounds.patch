     std::array<PendingViWrite, kMaxPendingViWrites> m_viWritePipeline{};
     std::array<PendingAccWrite, kMaxPendingAccWrites> m_accWritePipeline{};
+    // Per-pipeline lower bounds on the earliest queued readyCycle. A pipeline
+    // is scanned only once the current cycle reaches its bound; most cycles
+    // then touch one or two small arrays instead of every pipeline entry.
+    enum CommitPipeline : uint32_t { CommitFlags, CommitScalar, CommitStores, CommitVf, CommitVi, CommitAcc, CommitPipelineCount };
+    std::array<uint64_t, CommitPipelineCount> m_nextCommit{};
+    void noteCommitAt(CommitPipeline pipeline, uint64_t cycle)
+    {
+        if (cycle < m_nextCommit[pipeline])
+            m_nextCommit[pipeline] = cycle;
+    }
     XgkickPipeline m_xgkick{};
     std::array<std::array<uint64_t, 4>, 32> m_vfReady{};
     std::array<uint64_t, 16> m_viReady{};
