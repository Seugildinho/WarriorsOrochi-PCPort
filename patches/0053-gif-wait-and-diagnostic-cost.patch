                     uint64_t lo = loadLE64(data + offset);
                     uint64_t hi = loadLE64(data + offset + 8);
                     offset += 16;
-                    captureReservedGifAd("stream",data,sizeBytes,offset-16,tagLo,tagHi,regs[r],hi);
+                    if (regs[r] == 0xeu) // the capture only looks at A+D writes
