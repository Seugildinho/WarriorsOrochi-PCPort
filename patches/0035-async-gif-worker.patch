+void PS2Memory::queueGifJob(GifPathId pathId, const uint8_t *data, uint32_t sizeBytes, bool drainImmediately, bool path2DirectHl,
+                            std::function<void()> callback)
+{
+    bool wake;
+    {
+        std::unique_lock<std::mutex> lock(m_gifMutex);
+        // Bound how far the VIF1 worker may run ahead of the GS frontend.
+        m_gifIdleCv.wait(lock, [this] { return m_gifOutstanding < 4096u; });
+        GifJob job;
+        if (sizeBytes && !m_gifFreeBuffers.empty())
+        {
+            job.data = std::move(m_gifFreeBuffers.back());
+            m_gifFreeBuffers.pop_back();
+        }
+        job.data.assign(data, data + sizeBytes);
+        job.pathId = pathId;
+        job.drainImmediately = drainImmediately;
+        job.path2DirectHl = path2DirectHl;
+        job.callback = std::move(callback);
+        m_gifJobs.push_back(std::move(job));
+        ++m_gifOutstanding;
+        m_gifBusy.fetch_add(1u, std::memory_order_acq_rel);
+        // A sleeping worker is woken by a drain (end of a VIF1 transfer), a
+        // backlog, or syncGif; waking it for every packet costs the producer
+        // about as much as processing the packet.
+        wake = m_gifWorkerWaiting && (sizeBytes == 0u || m_gifJobs.size() >= 32u);
+    }
+    if (wake)
+        m_gifWorkCv.notify_one();
+}
