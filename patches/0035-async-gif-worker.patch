+void PS2Memory::syncGif() const
+{
+    if (!m_gifAsync || m_gifBusy.load(std::memory_order_acquire) == 0u ||
+        std::this_thread::get_id() == m_gifWorkerId)
+        return;
+    std::unique_lock<std::mutex> lock(m_gifMutex);
+    if (m_gifWorkerWaiting && !m_gifJobs.empty())
+        m_gifWorkCv.notify_one();
+    m_gifIdleCv.wait(lock, [this] { return m_gifOutstanding == 0u; });
 }
 
