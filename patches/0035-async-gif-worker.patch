+void PS2Memory::queueVif1Callback(std::function<void()> fn)
+{
+    if (m_vif1Async)
+    {
+        std::unique_lock<std::mutex> lock(m_vif1Mutex);
+        if (m_vif1Outstanding != 0u)
+        {
+            m_vif1IdleCv.wait(lock, [this] { return m_vif1Outstanding < 64u; });
+            Vif1Job job;
+            job.callback = std::move(fn);
+            m_vif1Jobs.push_back(std::move(job));
+            ++m_vif1Outstanding;
+            m_vif1Busy.fetch_add(1u, std::memory_order_acq_rel);
+            lock.unlock();
+            m_vif1WorkCv.notify_one();
+            return;
+        }
+        // Only this thread queues VIF1 work, so the worker stays idle and all
+        // of its output is already with the GIF worker.
+        if (m_gifAsync && m_gifArbiter && m_gifBusy.load(std::memory_order_acquire) != 0u)
+        {
+            lock.unlock();
+            queueGifJob(GifPathId::Path1, nullptr, 0u, true, false, std::move(fn));
+            return;
+        }
+    }
+    fn();
+}
