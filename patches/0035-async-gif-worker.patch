+void PS2Memory::stopGifWorker()
+{
+    if (!m_gifWorker.joinable())
+    {
+        m_gifAsync = false;
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_gifMutex);
+        m_gifStopping = true;
+    }
+    m_gifWorkCv.notify_all();
+    m_gifWorker.join();
+    m_gifAsync = false;
+}
+
+void PS2Memory::gifWorkerLoop()
+{
+    std::vector<GifJob> batch;
+    for (;;)
+    {
+        {
+            std::unique_lock<std::mutex> lock(m_gifMutex);
+            for (GifJob &job : batch)
+                if (job.data.capacity())
+                    m_gifFreeBuffers.push_back(std::move(job.data));
+            m_gifOutstanding -= static_cast<uint32_t>(batch.size());
+            m_gifBusy.fetch_sub(static_cast<uint32_t>(batch.size()), std::memory_order_acq_rel);
+            batch.clear();
+            m_gifIdleCv.notify_all();
+            if (m_gifJobs.empty() && !m_gifStopping)
+            {
+                // Packets come in bursts: poll briefly before sleeping, so the
+                // VIF1 worker rarely pays for a wake-up.
+                lock.unlock();
+                const auto until = std::chrono::steady_clock::now() + std::chrono::microseconds(50);
+                while (m_gifBusy.load(std::memory_order_acquire) == 0u && std::chrono::steady_clock::now() < until)
+                    _mm_pause();
+                lock.lock();
+            }
+            m_gifWorkerWaiting = true;
+            m_gifWorkCv.wait(lock, [this] { return m_gifStopping || !m_gifJobs.empty(); });
+            m_gifWorkerWaiting = false;
+            if (m_gifJobs.empty())
+                return;
+            batch.swap(m_gifJobs);
+        }
+        for (GifJob &job : batch)
+        {
+            if (job.callback)
+                job.callback();
+            else if (job.data.empty())
+                m_gifArbiter->drain();
+            else
+            {
+                const uint32_t size = static_cast<uint32_t>(job.data.size());
+                if (!job.drainImmediately || !m_gifArbiter->processDirect(job.pathId, job.data.data(), size))
+                {
+                    m_gifArbiter->submit(job.pathId, job.data.data(), size, job.path2DirectHl);
+                    if (job.drainImmediately)
+                        m_gifArbiter->drain();
+                }
+            }
+        }
+    }
+}
