+bool VU1Interpreter::runTranslated(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize,
+                                   GS &gs, PS2Memory *memory, uint32_t maxCycles)
+{
+    if (!s_translationLookup || m_unit != Unit::VU1 || !memory || vuCode != memory->getVU1Code())
+        return false;
+    // Microcode is re-uploaded often with identical contents; hash it once
+    // per upload generation so translations follow the code, not the upload.
+    const uint64_t generation = memory->getVU1CodeGeneration();
+    if (generation != m_translationGeneration)
+    {
+        uint64_t hash = 0xcbf29ce484222325ull;
+        for (uint32_t i = 0; i < codeSize; ++i)
+            hash = (hash ^ vuCode[i]) * 0x100000001b3ull;
+        m_translationCodeHash = hash;
+        m_translationGeneration = generation;
+    }
+    const TranslatedProgram program = s_translationLookup(m_translationCodeHash, m_state.pc, vuCode, codeSize);
+    if (!program)
+        return false;
+    program(*this, vuData, dataSize, gs, memory, maxCycles);
+    return true;
+}
