+    // Ahead-of-time translated microprograms. execute() asks the lookup for a
+    // translation of the current code image (by content hash) and entry PC;
+    // a returned program replaces run() for that call, so it must reproduce
+    // run()'s observable state, memory, PATH1 output and cycle count.
+    using TranslatedProgram = void (*)(VU1Interpreter &vu, uint8_t *vuData, uint32_t dataSize,
+                                       GS &gs, PS2Memory *memory, uint32_t maxCycles);
+    using TranslationLookup = TranslatedProgram (*)(uint64_t codeHash, uint32_t startPc,
+                                                    const uint8_t *vuCode, uint32_t codeSize);
+    static void setTranslationLookup(TranslationLookup lookup) { s_translationLookup = lookup; }
+
 private:
+    friend struct VU1TranslationAccess;
+    static inline TranslationLookup s_translationLookup = nullptr;
+    uint64_t m_translationGeneration = ~0ull;
+    uint64_t m_translationCodeHash = 0;
+    bool runTranslated(uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize,
+                       GS &gs, PS2Memory *memory, uint32_t maxCycles);
     enum Pipeline : uint8_t
