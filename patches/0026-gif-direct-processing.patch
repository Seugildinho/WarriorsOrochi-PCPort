+bool GifArbiter::processDirect(GifPathId pathId, const uint8_t *data, uint32_t sizeBytes)
+{
+    const auto path=static_cast<unsigned>(pathId);
+    if (!data || !sizeBytes || !m_processFn || path<1 || path>3 || !m_queue.empty() || !m_partial[path].empty())
+        return false;
+    // Same packet boundaries as submit(): each EOP-terminated run becomes one
+    // packet, processed in order (drain() never reorders one path's packets).
+    size_t cursor=0,packetStart=0;
+    while(sizeBytes-cursor>=16u) {
+        uint64_t tag{}; std::memcpy(&tag,data+cursor,8);
+        const size_t loops=tag&0x7fffu;
+        const unsigned format=(tag>>58)&3u;
+        size_t registers=(tag>>60)&15u;
+        if(!registers) registers=16;
+        const size_t payload=format==0 ? loops*registers*16u :
+            format==1 ? ((loops*registers+1u)/2u)*16u : loops*16u;
+        if(sizeBytes-cursor<16u+payload) break;
+        cursor+=16u+payload;
+        if(tag&(1ull<<15)) {
+            m_processFn(data+packetStart,static_cast<uint32_t>(cursor-packetStart));
+            packetStart=cursor;
+        }
+    }
+    if(packetStart<sizeBytes) m_partial[path].assign(data+packetStart,data+sizeBytes);
+    return true;
+}
