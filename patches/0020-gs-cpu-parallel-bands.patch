+void GSCpuBackend::InvalidateTextureCaches() const
+{
+    const_cast<GSCpuBackend *>(this)->m_textureGeneration.store(nextTextureGeneration(), std::memory_order_release);
+    m_writtenSinceInvalidate.clear();
+    m_unknownWriteSinceInvalidate = false;
+}
