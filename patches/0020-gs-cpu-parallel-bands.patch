+    // Rows owned by the current raster thread while a queued batch is drawn.
+    thread_local unsigned t_bandIndex = 0u;
+    thread_local unsigned t_bandCount = 1u;
+    // Palette snapshot of the queued primitive being drawn (nullptr: current CLUT).
+    thread_local const uint16_t *t_clut = nullptr;
