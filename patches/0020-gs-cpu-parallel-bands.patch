+                  << " rejectQueuedRead=" << m_stats.rejectQueuedRead << std::endl;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_workMutex);
+        m_workStop = true;
+    }
+    m_workReady.notify_all();
+    for (std::thread &worker : m_workers)
+        worker.join();
