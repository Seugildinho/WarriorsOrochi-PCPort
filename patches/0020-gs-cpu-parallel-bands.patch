+
+void GSCpuBackend::WorkerLoop(unsigned band)
+{
+    uint64_t seen = 0;
+    for (;;)
+    {
+        {
+            std::unique_lock<std::mutex> lock(m_workMutex);
+            m_workReady.wait(lock, [&] { return m_workStop || m_workEpoch != seen; });
+            if (m_workStop)
+                return;
+            seen = m_workEpoch;
+        }
+        DrawQueuedBand(band);
+        {
+            std::lock_guard<std::mutex> lock(m_workMutex);
+            if (--m_workPending == 0u)
+                m_workDone.notify_one();
+        }
+    }
+}
+
+void GSCpuBackend::DrawQueuedBand(unsigned band) const
+{
+    t_bandIndex = band;
+    t_bandCount = m_bandCount;
+    auto *self = const_cast<GSCpuBackend *>(this);
+    for (size_t i = 0; i < m_queue.size(); ++i)
+    {
+        t_clut = m_clutVersions[m_queueClut[i]].data();
+        self->DrawPrimitive(m_queue[i]);
+    }
+    t_clut = nullptr;
+    t_bandIndex = 0u;
+    t_bandCount = 1u;
+}
+
+void GSCpuBackend::DrainQueueUnlocked() const
+{
+    if (m_queue.empty())
+        return;
+    auto *self = const_cast<GSCpuBackend *>(this);
+    ++m_stats.batches;
+    m_stats.batchPrimitives += m_queue.size();
+    if (m_queueArea < 32768u)
+    {
+        // Same order, one thread: identical result without waking the bands.
+        InvalidateTextureCaches();
+        for (size_t i = 0; i < m_queue.size(); ++i)
+        {
+            t_clut = m_clutVersions[m_queueClut[i]].data();
+            self->DrawPrimitive(m_queue[i]);
+        }
+        t_clut = nullptr;
+        m_queue.clear();
+        m_queueWrites.clear();
+        m_queueReads.clear();
+        m_queueClut.clear();
+        m_clutVersions.clear();
+        m_clutChangedSinceSnapshot = true;
+        m_queueArea = 0;
+        NoteUnknownVramWrite();
+        return;
+    }
+    if (self->m_workers.empty())
+    {
+        for (unsigned band = 1; band < m_bandCount; ++band)
+            self->m_workers.emplace_back([self, band] { self->WorkerLoop(band); });
+    }
+    // Each band samples VRAM as of the start of the batch; nothing queued
+    // writes a sampled range, so this equals sampling current VRAM serially.
+    InvalidateTextureCaches();
+    {
+        std::lock_guard<std::mutex> lock(m_workMutex);
+        m_workPending = m_bandCount - 1u;
+        ++m_workEpoch;
+    }
+    m_workReady.notify_all();
+    DrawQueuedBand(0u);
+    {
+        std::unique_lock<std::mutex> lock(m_workMutex);
+        m_workDone.wait(lock, [&] { return m_workPending == 0u; });
+    }
+    m_queue.clear();
+    m_queueWrites.clear();
+    m_queueReads.clear();
+    m_queueClut.clear();
+    m_clutVersions.clear();
+    m_clutChangedSinceSnapshot = true;
+    m_queueArea = 0;
+    NoteUnknownVramWrite();
+}
