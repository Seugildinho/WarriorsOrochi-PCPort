+GSMem::TexturePageCache &GSCpuBackend::TextureCache()
+{
+    thread_local ThreadTextureCache local;
+    const uint64_t generation = m_textureGeneration.load(std::memory_order_acquire);
+    if (local.generation != generation)
+    {
+        local.cache.Invalidate();
+        local.generation = generation;
+    }
+    return local.cache;
+}
