+void GSCpuBackend::PrimitiveRanges(const GSPrimitiveBatch &batch, ByteRange &texture, ByteRange &frame, ByteRange &depth) const
+{
+    const GSDrawState &state = batch.state;
+    const auto &ctx = state.context;
+    const uint32_t fpsm = ctx.frame.psm;
+    // Byte ranges: whole 8 KiB pages over the scissor height. A page row is
+    // 32 lines for 32-bit layouts, 64 for 16/8-bit and 128 for 4-bit ones;
+    // every row spans fbw pages (an over-estimate for 8/4-bit layouts).
+    const uint64_t page = 8192u;
+    const uint64_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+    const uint64_t lastRow = static_cast<uint64_t>(std::max<int>(ctx.scissor.y1, 0));
+    auto pageRows = [&](uint32_t psm) -> uint64_t {
+        const uint32_t format = psm & 0x0Fu;
+        const uint32_t height = (format == 0u || format == 1u) ? 32u : (format == 4u ? 128u : 64u);
+        return lastRow / height + 1u;
+    };
+    auto layout = [&](uint32_t psm, uint32_t base) {
+        return (static_cast<uint64_t>(psm) << 48) | (fbw << 32) | static_cast<uint64_t>(base);
+    };
+    const uint64_t frameBegin = static_cast<uint64_t>(ctx.frame.fbp) * page;
+    frame = {frameBegin, frameBegin + pageRows(fpsm) * fbw * page, layout(fpsm, ctx.frame.fbp)};
+    // Depth is touched only by a reading test (GEQUAL/GREATER) or an unmasked write.
+    const uint32_t ztest = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    if (ztest >= 2u || !ctx.zbuf.zmask)
+    {
+        const uint64_t depthBegin = static_cast<uint64_t>(ctx.zbuf.zbp) * page;
+        depth = {depthBegin, depthBegin + pageRows(ctx.zbuf.psm) * fbw * page, layout(ctx.zbuf.psm | 0x100u, ctx.zbuf.zbp)};
+    }
+    else
+        depth = {0u, 0u, 0u};
+    texture = {0u, 0u};
+    if (state.prim.tme)
+    {
+        const auto &tex = ctx.tex0;
+        const uint32_t wrapV = static_cast<uint32_t>((ctx.clamp >> 2) & 3u);
+        const uint64_t height = wrapV >= 2u ? 1024u : std::max<uint32_t>(state.textureHeight, 1u);
+        const uint64_t tbw = std::max<uint32_t>(tex.tbw, 1u);
+        const uint64_t begin = static_cast<uint64_t>(tex.tbp0) * 256u;
+        texture = {begin, begin + (height / 32u + 2u) * tbw * page * 2u};
+    }
+}
+
+bool GSCpuBackend::CanQueueUnlocked(const ByteRange &texture, const ByteRange &frame, const ByteRange &depth) const
+{
+    const uint64_t fpsm = frame.layout >> 48;
+    if (fpsm == GS_PSM_T4 || fpsm == GS_PSM_T4HL || fpsm == GS_PSM_T4HH)
+        return (m_lastReject = 1u), false;
+    auto overlaps = [](const ByteRange &a, const ByteRange &b) { return a.begin < b.end && b.begin < a.end; };
+    // Bytes written through two different layouts belong to different rows.
+    if (overlaps(frame, depth))
+        return (m_lastReject = 2u), false;
+    for (const ByteRange &written : m_queueWrites)
+        if ((overlaps(frame, written) && written.layout != frame.layout) ||
+            (overlaps(depth, written) && written.layout != depth.layout))
+            return (m_lastReject = 2u), false;
+    if (texture.end != texture.begin)
+    {
+        // Sampled texels must not be written by this primitive or by
+        // anything already queued.
+        if (overlaps(texture, frame) || overlaps(texture, depth))
+            return (m_lastReject = 3u), false;
+        for (const ByteRange &written : m_queueWrites)
+            if (overlaps(texture, written))
+                return (m_lastReject = 4u), false;
+    }
+    // Nothing queued may sample what this primitive writes.
+    for (const ByteRange &read : m_queueReads)
+        if (overlaps(read, frame) || overlaps(read, depth))
+            return (m_lastReject = 5u), false;
+    return true;
+}
+
+void GSCpuBackend::QueueOrDrawUnlocked(const GSPrimitiveBatch &batch)
+{
+    ByteRange texture{}, frame{}, depth{};
+    PrimitiveRanges(batch, texture, frame, depth);
+    if (m_bandCount <= 1u || !CanQueueUnlocked(texture, frame, depth))
+    {
+        ++m_stats.serial;
+        if (m_bandCount > 1u)
+        {
+            uint64_t *reasons[] = {&m_stats.rejectT4, &m_stats.rejectLayout, &m_stats.rejectSelfSample,
+                                   &m_stats.rejectQueuedWrite, &m_stats.rejectQueuedRead};
+            if (m_lastReject >= 1u && m_lastReject <= 5u)
+                ++*reasons[m_lastReject - 1u];
+        }
+        DrainQueueUnlocked();
+        if (texture.end != texture.begin)
+        {
+            bool stale = m_unknownWriteSinceInvalidate;
+            for (const ByteRange &written : m_writtenSinceInvalidate)
+                stale = stale || (texture.begin < written.end && written.begin < texture.end);
+            if (stale)
+                InvalidateTextureCaches();
+        }
+        DrawPrimitive(batch);
+        if (m_writtenSinceInvalidate.size() < 64u)
+        {
+            m_writtenSinceInvalidate.push_back(frame);
+            m_writtenSinceInvalidate.push_back(depth);
+        }
+        else
+            m_unknownWriteSinceInvalidate = true;
+        return;
+    }
+    ++m_stats.queued;
+    if (m_clutChangedSinceSnapshot || m_clutVersions.empty())
+    {
+        m_clutVersions.push_back(m_clut);
+        m_clutChangedSinceSnapshot = false;
+    }
+    m_queueClut.push_back(static_cast<uint32_t>(m_clutVersions.size() - 1u));
+    {
+        const auto &ctx = batch.state.context;
+        float minX = batch.vertices[0].x, maxX = minX, minY = batch.vertices[0].y, maxY = minY;
+        for (unsigned v = 1; v < batch.vertexCount && v < 3u; ++v)
+        {
+            minX = std::min(minX, batch.vertices[v].x); maxX = std::max(maxX, batch.vertices[v].x);
+            minY = std::min(minY, batch.vertices[v].y); maxY = std::max(maxY, batch.vertices[v].y);
+        }
+        const float width = std::clamp(maxX - minX + 1.0f, 1.0f, float(ctx.scissor.x1 - ctx.scissor.x0 + 1));
+        const float height = std::clamp(maxY - minY + 1.0f, 1.0f, float(ctx.scissor.y1 - ctx.scissor.y0 + 1));
+        m_queueArea += static_cast<uint64_t>(width * height);
+    }
+    m_queue.push_back(batch);
+    m_queueWrites.push_back(frame);
+    m_queueWrites.push_back(depth);
+    if (texture.end != texture.begin)
+        m_queueReads.push_back(texture);
+    if (m_queue.size() >= 2048u)
+        DrainQueueUnlocked();
+}
