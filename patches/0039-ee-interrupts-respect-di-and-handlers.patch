+bool EeScheduler::interruptsBlocked() noexcept
+{
+    GuestThread *running = currentThread();
+    if (running == nullptr)
+    {
+        return false;
+    }
+    for (const GuestInvocation &invocation : running->invocations)
+    {
+        if (runsAsInterrupt(invocation.kind))
+        {
+            return true;
+        }
+    }
+    return (running->activeContext().cop0_status & kStatusEie) == 0u;
+}
