+std::vector<uint8_t> PS2Memory::takeVif1Buffer()
+{
+    std::lock_guard<std::mutex> lock(m_vif1PoolMutex);
+    if (m_vif1Pool.empty())
+        return {};
+    std::vector<uint8_t> buffer = std::move(m_vif1Pool.back());
+    m_vif1Pool.pop_back();
+    return buffer;
+}
+
+void PS2Memory::recycleVif1Buffer(std::vector<uint8_t> &&buffer)
+{
+    if (buffer.capacity() == 0u)
+        return;
+    buffer.clear();
+    std::lock_guard<std::mutex> lock(m_vif1PoolMutex);
+    if (m_vif1Pool.size() < 16u)
+        m_vif1Pool.push_back(std::move(buffer));
+}
