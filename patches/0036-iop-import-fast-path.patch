+    // Runs before every IOP instruction: most are rejected by their first
+    // word, and import stubs come back from m_decoded instead of a backward
+    // search for their table.
     std::optional<IopImportCall> IopImportRegistry::decode(uint32_t pc) const
+    {
+        constexpr uint32_t kMaxCachedSpan = 4096u;
+        const uint32_t physicalPc = IopMemory::physicalAddress(pc);
+        const auto ram = m_memory.ram();
+        const bool inRam = (physicalPc & 3u) == 0u && physicalPc + 8u <= ram.size();
+        if (inRam)
+        {
+            uint32_t word, delay;
+            std::memcpy(&word, ram.data() + physicalPc, sizeof(word));
+            if (word != 0x03E00008u)
+                return std::nullopt;
+            // Ordinary function returns: no "addiu $zero, $zero, ordinal" slot.
+            std::memcpy(&delay, ram.data() + physicalPc + 4u, sizeof(delay));
+            if ((delay & 0xFFFF0000u) != 0x24000000u)
+                return std::nullopt;
+            const auto cached = m_decoded.find(physicalPc);
+            if (cached != m_decoded.end() &&
+                std::memcmp(ram.data() + cached->second.table, cached->second.bytes.data(), cached->second.bytes.size()) == 0)
+                return cached->second.call;
+        }
+        uint32_t table = 0u;
+        auto call = decodeUncached(pc, table);
+        if (call && inRam && physicalPc + 8u - table <= kMaxCachedSpan)
+        {
+            auto &entry = m_decoded[physicalPc];
+            entry.table = table;
+            entry.bytes.assign(ram.begin() + table, ram.begin() + physicalPc + 8u);
+            entry.call = *call;
+        }
+        return call;
+    }
