+    // IopImportRegistry::decode keeps decoded stubs; every byte its search
+    // read must still be checked, so rewriting the table, the stub or its
+    // delay slot is seen on the next call.
+    bool testImportStubDecodeFollowsMemory()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        const uint32_t table = 0x20000u;
+        auto setName = [&](const char *name)
+        {
+            for (uint32_t i = 0; i < 8u; ++i)
+                memory.write8(table + 12u + i, static_cast<uint8_t>(name[i]));
+        };
+        memory.write32(table, 0x41E00000u);
+        memory.write16(table + 8u, 0x0101u);
+        setName("thsemap\0");
+        memory.write32(table + 20u, 0x03E00008u);
+        memory.write32(table + 24u, 0x24000006u);
+        memory.write32(table + 28u, 0x03E00008u);
+        memory.write32(table + 32u, 0x24000007u);
+        const uint32_t stub = 0x80000000u | (table + 28u);
+        auto matches = [&](const char *library, uint16_t ordinal)
+        {
+            const auto call = imports.decode(stub);
+            return call && call->library == library && call->ordinal == ordinal && call->version == 0x0101u;
+        };
+        if (!expect(matches("thsemap", 7u), "import stub was not decoded") ||
+            !expect(matches("thsemap", 7u), "repeated import stub decode changed"))
+            return false;
+        setName("thevent\0");
+        if (!expect(matches("thevent", 7u), "decode kept a library name rewritten in RAM"))
+            return false;
+        memory.write32(table + 32u, 0x24000009u);
+        if (!expect(matches("thevent", 9u), "decode kept an ordinal rewritten in RAM"))
+            return false;
+        memory.write32(table + 20u, 0u);
+        memory.write32(table + 24u, 0u);
+        if (!expect(!imports.decode(stub), "decode kept a stub cut off from its table"))
+            return false;
+        memory.write32(table + 20u, 0x03E00008u);
+        memory.write32(table + 24u, 0x24000006u);
+        memory.write32(stub, 0u);
+        return expect(!imports.decode(stub), "decode kept a stub overwritten in RAM");
+    }
