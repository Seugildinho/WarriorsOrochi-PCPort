@@ -74,7 +74,7 @@ void VU1Interpreter::resetScheduler()
     m_viWritePipeline = {};
     m_accWritePipeline = {};
     m_nextCommit = {};
-    m_xgkick = {};
+    m_xgkick.resetControl();
     m_vfReady = {};
     m_viReady = {};
     m_accReady = {};
@@ -1013,7 +1013,7 @@ void VU1Interpreter::startXgkick(uint32_t qwordAddress)
         return;
 
     const uint32_t sourceAddress = (qwordAddress * 16u) % m_activeVuDataSize;
