diff --git a/ps2xRuntime/include/runtime/ps2_vu1.h b/ps2xRuntime/include/runtime/ps2_vu1.h
index 4dd6eff..20b463d 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1.h
@@ -205,6 +205,21 @@ private:
         uint64_t issueCycle = 0;
         bool active = false;
         bool currentTagEop = false;
+
+        // Same as assigning {} except for `packet`: a transfer only reads the
+        // bytes it already copied, so clearing 64 KiB on every program start
+        // (resetScheduler, startXgkick) is unnecessary.
+        void resetControl()
+        {
+            sourceAddress = 0;
+            totalBytes = 0;
+            copiedBytes = 0;
+            currentTagEnd = 0;
+            cycleCredit = 0;
+            issueCycle = 0;
+            active = false;
+            currentTagEop = false;
+        }
     };
 
     static constexpr uint32_t kFmacLatency = 4u;
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
