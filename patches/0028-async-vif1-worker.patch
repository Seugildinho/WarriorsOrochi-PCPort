+void PS2Runtime::enableAsyncVif1(bool enabled)
+{
+    if (!enabled || !m_eeScheduler)
+    {
+        m_memory.setVif1Async(false);
+        return;
+    }
+    m_memory.setVif1Async(
+        true,
+        [this] { m_eeScheduler->postEvent(EeEvent{EeEventType::Dmac, 1u, 0u}); },
+        [this]() -> uint32_t
+        {
+            R5900Context *cpuContext = m_eeScheduler->currentContext();
+            return (cpuContext ? cpuContext : &m_cpuContext)->vu0_fbrst;
+        });
+}
+
+void PS2Runtime::completeAsyncVif1(uint8_t *rdram)
+{
+    if (const uint32_t vpu = m_memory.takeVif1VpuStatResult())
+    {
+        R5900Context *cpuContext = m_eeScheduler ? m_eeScheduler->currentContext() : nullptr;
+        if (!cpuContext)
+            cpuContext = &m_cpuContext;
+        cpuContext->vu0_vpu_stat = (cpuContext->vu0_vpu_stat & ~0x0600u) | (vpu & 0x0600u);
+    }
+    drainCompletedDmacHandlers(rdram);
+}
