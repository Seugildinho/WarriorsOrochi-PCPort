+void PS2Memory::applyVif1RegisterWrite(uint32_t address, uint32_t value)
+{
+    switch (address)
+    {
+    case 0x10003C10u:     // VIF1_FBRST
+        if (value & 0x1u) // RST
+        {
+            const bool wasPath3Masked = m_path3Masked;
+            std::memset(&vif1_regs, 0, sizeof(vif1_regs));
+            m_vif1PendingDirectQwc = 0u;
+            m_vif1PendingDirectHl = false;
+            m_path3Masked = false;
+            if (wasPath3Masked)
+                flushMaskedPath3Packets();
+        }
+        if (value & 0x8u) // STC
+        {
+            vif1_regs.stat &= ~((1u << 8) | (1u << 9) | (1u << 10) | (1u << 11) | (1u << 12) | (1u << 13));
+        }
+        break;
+    case 0x10003C30u:
+        vif1_regs.mark = value & 0xFFFFu;
+        vif1_regs.stat &= ~(1u << 6); // clear MRK flag on CPU write
+        break;
+    case 0x10003C40u:
+        vif1_regs.cycle = value & 0xFFFFu;
+        break;
+    case 0x10003C50u:
+        vif1_regs.mode = value & 0x3u;
+        break;
+    case 0x10003C60u:
+        vif1_regs.num = value & 0xFFu;
+        break;
+    case 0x10003C70u:
+        vif1_regs.mask = value;
+        break;
+    case 0x10003C80u:
+        vif1_regs.code = value;
+        break;
+    case 0x10003C90u:
+        vif1_regs.itops = value & 0x3FFu;
+        break;
+    case 0x10003CA0u:
+        vif1_regs.base = value & 0x3FFu;
+        break;
+    case 0x10003CB0u:
+        vif1_regs.ofst = value & 0x3FFu;
+        break;
+    case 0x10003CC0u:
+        vif1_regs.tops = value & 0x3FFu;
+        break;
+    case 0x10003CD0u:
+        vif1_regs.itop = value & 0x3FFu;
+        break;
+    case 0x10003CE0u:
+        vif1_regs.top = value & 0x3FFu;
+        break;
+    default:
+        break;
+    }
+}
+
+void PS2Memory::setVif1Async(bool enabled, std::function<void()> notify, std::function<uint32_t()> fbrst)
+{
+    if (!enabled)
+    {
+        stopVif1Worker();
+        return;
+    }
+    if (m_vif1Async)
+        return;
+    m_vif1Notify = std::move(notify);
+    m_vif1Fbrst = std::move(fbrst);
+    m_vif1Stopping = false;
+    m_vif1Worker = std::thread([this] { vif1WorkerLoop(); });
+    m_vif1WorkerId = m_vif1Worker.get_id();
+    m_vif1Async = true;
+}
+
+void PS2Memory::stopVif1Worker()
+{
+    if (!m_vif1Worker.joinable())
+    {
+        m_vif1Async = false;
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_vif1Mutex);
+        m_vif1Stopping = true;
+    }
+    m_vif1WorkCv.notify_all();
+    m_vif1Worker.join();
+    m_vif1Async = false;
+}
+
+void PS2Memory::vif1WorkerLoop()
+{
+    for (;;)
+    {
+        Vif1Job job;
+        {
+            std::unique_lock<std::mutex> lock(m_vif1Mutex);
+            m_vif1WorkCv.wait(lock, [this] { return m_vif1Stopping || !m_vif1Jobs.empty(); });
+            if (m_vif1Jobs.empty())
+                return;
+            job = std::move(m_vif1Jobs.front());
+            m_vif1Jobs.pop_front();
+        }
+        m_vif1JobFbrst = job.fbrst;
+        try
+        {
+            if (job.registerWrite)
+                applyVif1RegisterWrite(job.address, job.value);
+            else if (!job.data.empty())
+                processVIF1Data(job.data.data(), static_cast<uint32_t>(job.data.size()));
+        }
+        catch (const std::exception &error)
+        {
+            static bool reported = false;
+            if (!reported)
+            {
+                reported = true;
+                std::cerr << "[vif1-async] transfer failed: " << error.what() << std::endl;
+            }
+        }
+        if (m_gifArbiter && !job.registerWrite)
+            m_gifArbiter->drain();
+        finishVif1Transfer();
+    }
+}
+
+void PS2Memory::queueVif1Job(Vif1Job job)
+{
+    // Small work with an idle worker runs here: handing it over costs more
+    // than it saves (loading screens send many tiny transfers). Order is kept
+    // because only this thread queues work and the queue is empty.
+    constexpr size_t kInlineBytes = 8u * 1024u;
+    if (job.registerWrite || job.data.size() < kInlineBytes)
+    {
+        bool idle;
+        {
+            std::lock_guard<std::mutex> lock(m_vif1Mutex);
+            idle = m_vif1Outstanding == 0u;
+        }
+        if (idle)
+        {
+            if (job.registerWrite)
+                applyVif1RegisterWrite(job.address, job.value);
+            else
+            {
+                processVIF1Data(job.data.data(), static_cast<uint32_t>(job.data.size()));
+                if (m_gifArbiter)
+                    m_gifArbiter->drain();
+            }
+            return;
+        }
+    }
+    {
+        std::unique_lock<std::mutex> lock(m_vif1Mutex);
+        // Bound how far the EE may run ahead of the worker.
+        m_vif1IdleCv.wait(lock, [this] { return m_vif1Outstanding < 64u; });
+        m_vif1Jobs.push_back(std::move(job));
+        ++m_vif1Outstanding;
+        m_vif1Busy.fetch_add(1u, std::memory_order_acq_rel);
+    }
+    m_vif1WorkCv.notify_one();
+}
+
+void PS2Memory::finishVif1Transfer()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_vif1Mutex);
+        --m_vif1Outstanding;
+        m_vif1Busy.fetch_sub(1u, std::memory_order_acq_rel);
+    }
+    m_vif1IdleCv.notify_all();
+    if (m_vif1Notify && (m_vif1VpuStat.load(std::memory_order_acquire) & 0x80000000u) != 0u)
+        m_vif1Notify();
+}
+
+void PS2Memory::syncVif1() const
+{
+    if (!m_vif1Async || m_vif1Busy.load(std::memory_order_acquire) == 0u ||
+        std::this_thread::get_id() == m_vif1WorkerId)
+        return;
+    std::unique_lock<std::mutex> lock(m_vif1Mutex);
+    m_vif1IdleCv.wait(lock, [this] { return m_vif1Outstanding == 0u; });
+}
+
+void PS2Memory::syncVif1ForIo(uint32_t address, bool write)
+{
+    // Registers that show (or change) what the worker produces: GIF
+    // registers, VIF1 registers (reads; writes are queued), the VIF1/GIF
+    // FIFOs and the GS privileged registers. DMAC channel registers and
+    // D_STAT already show the transfer complete.
+    const bool related = (address >= 0x10003000u && address < 0x10003100u) ||
+                         (!write && address >= 0x10003C00u && address < 0x10003E00u) ||
+                         (address >= 0x10005000u && address < 0x10007000u) ||
+                         (address >= 0x12000000u && address < 0x12002000u);
+    if (!related || m_vif1Busy.load(std::memory_order_acquire) == 0u ||
+        std::this_thread::get_id() == m_vif1WorkerId)
+        return;
+    syncVif1();
+}
