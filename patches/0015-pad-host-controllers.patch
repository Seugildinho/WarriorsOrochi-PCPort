     constexpr uint16_t PAD_L2 = 0x0100u;
+
+    // An optional SDL_GameControllerDB file next to the executable adds
+    // mappings for controllers GLFW does not recognise as gamepads by default.
+    void loadGamepadMappingsOnce()
+    {
+        static bool loaded = false;
+        if (loaded)
+            return;
+        loaded = true;
+        const std::string path = std::string(GetApplicationDirectory()) + "gamecontrollerdb.txt";
+        if (!FileExists(path.c_str()))
+            return;
+        if (char *text = LoadFileText(path.c_str()))
+        {
+            SetGamepadMappings(text);
+            UnloadFileText(text);
+        }
+    }
+
+    // Port N follows the Nth connected gamepad, so a second controller drives
+    // player 2 instead of both ports mirroring gamepad 0.
+    int gamepadForPort(int port)
+    {
+        int seen = 0;
+        for (int i = 0; i < kMaxGamepads; ++i)
+        {
+            if (!IsGamepadAvailable(i))
+                continue;
+            if (seen == port)
+                return i;
+            ++seen;
+        }
+        return -1;
+    }
+
+    uint8_t axisToByte(float value)
+    {
+        if (value > -kStickDeadzone && value < kStickDeadzone)
+            return kPadStickCenter;
+        value = std::clamp(value, -1.0f, 1.0f);
+        return static_cast<uint8_t>(std::lround(127.5f + value * 127.5f));
+    }
 }
 
