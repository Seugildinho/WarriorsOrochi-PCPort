 {
     assertExecutor();
+    // Runs around every guest call and nothing is due nearly every time; the
+    // clock read, locks and allocation below cost more than the call it follows.
+    const uint64_t nextDeadlineCycle = m_nextDeadlineCycle.load(std::memory_order_acquire);
+    if (!m_checkpointPending.load(std::memory_order_acquire) && m_pendingEeTimerInterrupts == 0u &&
+        (nextDeadlineCycle == 0u || m_eeCycle < nextDeadlineCycle))
+    {
+        applyPendingPreemption();
+        return;
+    }
     processDueDeadlines();
     const uint32_t timerInterrupts = m_pendingEeTimerInterrupts;
     m_pendingEeTimerInterrupts = 0u;
