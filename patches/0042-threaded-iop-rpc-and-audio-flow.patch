+namespace
+{
+    // SPU2 samples from the IOP (game thread) to raylib's audio thread. At
+    // most 200 ms wait: when the game produces faster than real time the
+    // oldest frames go, so latency stays bounded; an empty buffer plays
+    // silence.
+    struct Spu2Stream
+    {
+        static constexpr size_t kCapacity = 9600u;
+        std::mutex mutex;
+        std::vector<int16_t> ring = std::vector<int16_t>(kCapacity * 2u);
+        size_t read = 0u, count = 0u;
+        AudioStream stream{};
+        bool started = false;
+    };
+
+    Spu2Stream &spu2Stream()
+    {
+        static Spu2Stream stream;
+        return stream;
+    }
+
+    void pullSpu2(void *buffer, unsigned int frames)
+    {
+        Spu2Stream &s = spu2Stream();
+        auto *out = static_cast<int16_t *>(buffer);
+        std::lock_guard<std::mutex> lock(s.mutex);
+        for (unsigned int i = 0; i < frames; ++i)
+        {
+            if (s.count == 0u)
+            {
+                out[i * 2u] = out[i * 2u + 1u] = 0;
+                continue;
+            }
+            out[i * 2u] = s.ring[s.read * 2u];
+            out[i * 2u + 1u] = s.ring[s.read * 2u + 1u];
+            s.read = (s.read + 1u) % Spu2Stream::kCapacity;
+            --s.count;
+        }
+    }
+}
