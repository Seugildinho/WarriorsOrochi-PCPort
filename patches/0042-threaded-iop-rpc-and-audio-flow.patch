+    bool IopKernel::callInSleepingThread(int id, uint32_t pc, uint32_t gp, uint32_t a0, uint32_t a1, uint32_t a2,
+                                         uint32_t returnAddress)
+    {
+        const auto it = m_threads.find(id);
+        if (it == m_threads.end() || it->second.state != IopThreadState::Sleep)
+            return false;
+        m_idleKnown = false;
+        IopCpuState &cpu = it->second.cpu;
+        cpu.pc = pc;
+        cpu.branchPending = false;
+        cpu.stopped = false;
+        cpu.yielded = false;
+        cpu.gpr[4] = a0;
+        cpu.gpr[5] = a1;
+        cpu.gpr[6] = a2;
+        cpu.gpr[28] = gp;
+        it->second.sleepingCallSp = cpu.gpr[29];
+        cpu.gpr[29] = (cpu.gpr[29] - 64u) & ~15u;
+        cpu.gpr[31] = returnAddress;
+        it->second.state = IopThreadState::Ready;
+        return true;
+    }
+
+    void IopKernel::endSleepingCall(IopCpuState &cpu)
+    {
+        if (m_currentThread != nullptr)
+            cpu.gpr[29] = m_currentThread->sleepingCallSp;
+    }
