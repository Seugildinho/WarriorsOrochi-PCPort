+    bool IopRpcBridge::queueBusy(uint32_t sid) const
+    {
+        const auto queue = m_queues.find(sid);
+        return queue != m_queues.end() && (queue->second.running || !queue->second.requests.empty());
+    }
+
+    void IopRpcBridge::startQueued(uint32_t sid)
+    {
+        ServerQueue &queue = m_queues[sid];
+        const auto serverIt = m_servers.find(sid);
+        if (queue.running || queue.requests.empty() || serverIt == m_servers.end())
+            return;
+        const RpcServer &server = serverIt->second;
+        const auto loop = m_loopThreads.find(server.queue);
+        if (loop == m_loopThreads.end())
+            return;
+        const QueuedRequest &request = queue.requests.front();
+        if (!request.send.empty() && server.buffer != 0u)
+        {
+            const uint32_t room = IopMemory::RamSize - std::min(IopMemory::physicalAddress(server.buffer), IopMemory::RamSize);
+            (void)m_memory.writeRam(server.buffer, request.send.data(), std::min<size_t>(request.send.size(), room));
+        }
+        if (m_kernel.callInSleepingThread(loop->second, server.function, server.gp, request.function, server.buffer,
+                                          static_cast<uint32_t>(request.send.size()), kRpcReturnSentinel))
+        {
+            queue.running = true;
+            m_runningSid[loop->second] = sid;
+        }
+    }
+
+    void IopRpcBridge::finishThreadedRequest(IopCpuState &cpu)
+    {
+        m_kernel.endSleepingCall(cpu);
+        const int thread = m_kernel.currentThreadId();
+        const auto running = m_runningSid.find(thread);
+        if (running != m_runningSid.end())
+        {
+            const uint32_t sid = running->second;
+            m_runningSid.erase(running);
+            ServerQueue &queue = m_queues[sid];
+            if (!queue.requests.empty())
+            {
+                const QueuedRequest &request = queue.requests.front();
+                uint32_t result = cpu.gpr[2];
+                if (result == 0u)
+                {
+                    const auto serverIt = m_servers.find(sid);
+                    result = serverIt != m_servers.end() ? serverIt->second.buffer : 0u;
+                }
+                const uint32_t physical = IopMemory::physicalAddress(result);
+                if (request.receive.address != 0u && request.receive.size != 0u && physical < IopMemory::RamSize)
+                    (void)m_host.writeGuest(request.receive.address, m_memory.ram().data() + physical,
+                                            std::min<uint32_t>(request.receive.size, IopMemory::RamSize - physical));
+                if (request.client != 0u)
+                    m_host.rpcFinished(request.client);
+                queue.requests.pop_front();
+            }
+            queue.running = false;
+            // Back to sceSifRpcLoop's wait; the next request (if any) wakes it.
+            m_kernel.sleepCurrent(cpu);
+            startQueued(sid);
+            return;
+        }
+        m_kernel.sleepCurrent(cpu);
+    }
