+void PS2IopHostAdapter::spu2Output(const int16_t *stereo, size_t frames)
+{
+    Spu2Stream &s = spu2Stream();
+    // OROCHI_SPU2_MUTE=1: no playback (the WAV recording below still runs).
+    static const bool muted = std::getenv("OROCHI_SPU2_MUTE") != nullptr;
+    if (!s.started && !muted)
+    {
+        if (!IsAudioDeviceReady())
+            return;
+        s.stream = LoadAudioStream(48000u, 16u, 2u);
+        SetAudioStreamCallback(s.stream, pullSpu2);
+        PlayAudioStream(s.stream);
+        s.started = true;
+    }
+    // OROCHI_SPU2_WAV=<path>: also record the first 10 minutes to a WAV file
+    // and log the peak level every 5 s (to check sound without listening).
+    static std::FILE *wav = [] {
+        const char *path = std::getenv("OROCHI_SPU2_WAV");
+        std::FILE *file = path ? std::fopen(path, "wb") : nullptr;
+        if (file)
+        {
+            const uint8_t header[44] = {'R','I','F','F',0,0,0,0,'W','A','V','E','f','m','t',' ',16,0,0,0,1,0,2,0,
+                                        0x80,0xBB,0,0,0x00,0xEE,0x02,0,4,0,16,0,'d','a','t','a',0,0,0,0};
+            std::fwrite(header, 1, sizeof(header), file);
+        }
+        return file;
+    }();
+    static uint64_t recorded = 0u, intervalFrames = 0u;
+    static int32_t intervalPeak = 0;
+    if (wav)
+    {
+        for (size_t i = 0; i < frames * 2u; ++i)
+            intervalPeak = std::max<int32_t>(intervalPeak, std::abs(static_cast<int32_t>(stereo[i])));
+        intervalFrames += frames;
+        if (intervalFrames >= 240000u)
+        {
+            std::cout << "[Orochi:spu2] frames=" << intervalFrames << " peak=" << intervalPeak << std::endl;
+            intervalFrames = 0u;
+            intervalPeak = 0;
+        }
+        if (recorded < 48000u * 600u)
+        {
+            std::fwrite(stereo, sizeof(int16_t) * 2u, frames, wav);
+            const uint64_t before = recorded;
+            recorded += frames;
+            // Header sizes once per recorded second (the file stays playable).
+            if (before / 48000u != recorded / 48000u)
+            {
+                const uint32_t dataBytes = static_cast<uint32_t>(recorded * 4u), riffBytes = dataBytes + 36u;
+                std::fseek(wav, 4, SEEK_SET);
+                std::fwrite(&riffBytes, 4, 1, wav);
+                std::fseek(wav, 40, SEEK_SET);
+                std::fwrite(&dataBytes, 4, 1, wav);
+                std::fseek(wav, 0, SEEK_END);
+            }
+        }
+    }
+    std::lock_guard<std::mutex> lock(s.mutex);
+    for (size_t i = 0; i < frames; ++i)
+    {
+        if (s.count == Spu2Stream::kCapacity)
+        {
+            s.read = (s.read + 1u) % Spu2Stream::kCapacity;
+            --s.count;
+        }
+        const size_t slot = (s.read + s.count) % Spu2Stream::kCapacity;
